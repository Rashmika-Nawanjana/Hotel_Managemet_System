generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  GUEST
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IdType {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENSE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum AmenityCategory {
  ENTERTAINMENT
  COMFORT
  BATHROOM
  TECHNOLOGY
  FOOD_BEVERAGE
  SAFETY
  ACCESSIBILITY
}

// Main User Table
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String        // Hashed
  role            UserRole      @default(GUEST)
  status          UserStatus    @default(ACTIVE)
  emailVerified   Boolean       @default(false)
  
  // Personal Information
  firstName       String
  lastName        String
  phone           String
  dateOfBirth     DateTime
  nationality     String
  
  // ID Information
  idType          IdType
  idNumber        String
  
  // Address Information
  address         String
  city            String
  postalCode      String
  
  // Two-Factor Authentication (for Admin/Staff)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?   // Store encrypted TOTP secret
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastLoginAt     DateTime?
  
  // Relations
  guestProfile        GuestProfile?
  staffProfile        StaffProfile?
  verificationTokens  VerificationToken[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

// Guest-specific profile
model GuestProfile {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String   @unique

  // Loyalty & Stats
  loyaltyPoints     Int      @default(0)
  memberSince       DateTime @default(now())
  totalBookings     Int      @default(0)
  totalSpent        Decimal  @default(0) @db.Decimal(10, 2)

  // Room Preferences
  preferredRoomType String?
  preferredBedType  String?
  smokingPreference String?  @default("non-smoking")
  floorPreference   String?
  pillowType        String?

  // Communication Preferences
  newsletter        Boolean  @default(true)
  emailNotifications Boolean @default(true)
  smsNotifications  Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("guest_profiles")
}

// Staff-specific profile
model StaffProfile {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String   @unique

  employeeId        String   @unique
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])

  department        String
  position          String
  salary            Decimal? @db.Decimal(10, 2)
  hireDate          DateTime

  // Performance
  rating            Decimal? @db.Decimal(3, 2)
  totalServices     Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("staff_profiles")
}

// Branch Model
model Branch {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  location    String
  address     String
  phone       String
  email       String

  totalRooms  Int
  status      String         @default("operational")

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  staff       StaffProfile[]
  roomTypes   RoomType[]      
  rooms       Room[]          


  @@map("branches")
}

// Room Type Model - Categories of rooms
model RoomType {
  id                String   @id @default(cuid())
  name              String   // "Deluxe Room", "Executive Suite", "Standard Room"
  slug              String   @unique
  description       String   @db.Text
  shortDescription  String?  @db.VarChar(200)
  
  // Pricing
  basePrice         Decimal  @db.Decimal(10, 2)
  
  // Specifications
  maxOccupancy      Int      // Maximum number of guests
  bedType           String   // "King", "Queen", "Twin", "Double"
  numberOfBeds      Int      @default(1)
  roomSize          Int      // in square meters
  
  // View type
  viewType          String?  // "Ocean View", "Garden View", "City View", "Pool View"
  
  // Branch
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  // Status
  status            String   @default("active") // active, inactive, coming_soon
  
  // Featured
  isFeatured        Boolean  @default(false)
  popularityScore   Int      @default(0)
  
  // Relations
  rooms             Room[]
  amenities         RoomTypeAmenity[]
  images            RoomImage[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("room_types")
}

// Individual Room Instances
model Room {
  id              String      @id @default(cuid())
  roomNumber      String      // "101", "205", "3A", "Presidential-1"
  floor           Int
  
  roomTypeId      String
  roomType        RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  status          RoomStatus  @default(AVAILABLE)
  
  // Additional notes for maintenance, special features, etc.
  notes           String?     @db.Text
  
  // Last cleaned timestamp
  lastCleaned     DateTime?
  lastMaintenance DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@unique([roomNumber, branchId])
  @@map("rooms")
}

// Amenities (WiFi, TV, Mini-bar, etc.)
model Amenity {
  id              String            @id @default(cuid())
  name            String            @unique
  icon            String?           // Icon name or emoji
  description     String?
  category        AmenityCategory
  
  roomTypes       RoomTypeAmenity[]
  
  createdAt       DateTime          @default(now())
  
  @@map("amenities")
}

// Junction table for Room Types and Amenities (Many-to-Many)
model RoomTypeAmenity {
  id              String   @id @default(cuid())
  
  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  amenityId       String
  amenity         Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@unique([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

// Room Images
model RoomImage {
  id              String   @id @default(cuid())
  url             String   // Image URL (cloud storage)
  caption         String?
  altText         String?
  isPrimary       Boolean  @default(false) // Main display image
  order           Int      @default(0)     // Display order
  
  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@map("room_images")
}

// Verification Token Model
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@map("verification_tokens")
}

// forgot password

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@map("password_reset_tokens")
}